{
  "name": "assistant-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute desk-assistant --remote --file=./migrations/0001_init.sql",
    "db:init:push": "wrangler d1 execute desk-assistant --remote --file=./migrations/0002_push.sql",
    "db:init:local": "wrangler d1 execute desk-assistant --local --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "~5.6.2",
    "wrangler": "^3.78.0"
  }
}
